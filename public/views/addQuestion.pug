extends base

block content
  <br>
  <br>
  <br>
  <br>

  <br>

  h1 New Question
  .login-form(style="margin: 20px; width: 75vw;")
    form(enctype='multipart/form-data' style="display: flex; flex-direction: column; gap: 15px;")
      label.login-form__username Problem Statement
      input#statement(type='text' name='problem' placeholder='State the question' style="margin-bottom: 10px;")
      
      label.login-form__username Problem Image (Optional)
      input#problemImage(type='file' name='problemImage' accept='image/*' style="margin-bottom: 10px;")

      label.login-form__username Answer 
      input#answer(type='text' name='answer' placeholder='All Lowercase' style="margin-bottom: 10px;")
      
      label.login-form__username Hint
      input#hint(type='text' name='hint' placeholder='Help the contestants out' style="margin-bottom: 10px;")
      
      label.login-form__username Hint Image (Optional)
      input#hintImage(type='file' name='hintImage' accept='image/*' style="margin-bottom: 10px;")

      label.login-form__username Level Number
      input#level(type='text' name='level' placeholder='Problem level number' style="margin-bottom: 10px;")

      button(class="btn waves-effect waves-light" type="submit" name="action" style="margin-top: 10px;") Submit

block append scripts
  script(src="/js/newQuestion.js")
