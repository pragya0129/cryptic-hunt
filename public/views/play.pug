extends base

block content 
  if question.completed
    h2 Congratulations!
  else 
    .container(style="display: flex; justify-content: space-between; align-items: flex-start; width: 75vw; margin: auto;")
      .left-section(style="width: 45%;")
        h3 Level #{question.level}
        h4= question.problem
      
      .right-section(style="width: 45%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #f9f9f9; padding: 20px; border-radius: 10px; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);")
        form.question-form(style="display: flex; flex-direction: column; align-items: center; width: 100%;")
          label.login-form__username Answer
          input#answer(type='text' name='answer' placeholder='Your answer here!' required style="width: 80%; margin-bottom: 10px;")

          button(class="btn waves-effect waves-light" type="submit" name="action" style="margin-top: 10px;") Submit

    .hint-container(style="position: fixed; bottom: 20px; right: 20px;")
      button(id="hint-btn" class="btn waves-effect waves-light") Show Hint
      p.hint(id="hint-text" style="display: none; margin-top: 10px;") Hint: #{question.hint}

block append scripts
  script(src="/js/submitQuestion.js")
  script.
    document.getElementById('hint-btn').addEventListener('click', function() {
      var hintText = document.getElementById('hint-text');
      if (hintText.style.display === 'none') {
        hintText.style.display = 'block';
        this.textContent = 'Hide Hint';
      } else {
        hintText.style.display = 'none';
        this.textContent = 'Show Hint';
      }
    });